#!/usr/bin/env bash
# 로컬 pre-push 관문 (QMIT 결정 4). docs/dev/pipeline.md 5장.
# push되는 범위에서 바뀐 모듈과 그것에 기대는 모듈만 scripts/verify.sh 로 돌리고, 실패하면 push를 막는다.
# 켜기(한 번): git config core.hooksPath .githooks
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
fail=0
while read -r _lref lsha _rref rsha; do
  [ -z "${lsha:-}" ] && continue
  case "$lsha" in *[!0]*) ;; *) continue ;; esac # 지우는 push 는 검사할 것이 없다
  case "$rsha" in
    *[!0]*) base="$rsha" ;;
    *) base="origin/main" ;; # 새 브랜치
  esac
  echo "pre-push 관문: 기준 $base"
  if ! bash scripts/verify.sh --affected --base "$base"; then fail=1; fi
  # 공급망 발행일(QMIT 결정 8): lock 파일이 바뀐 push 에서만. 네트워크가 없으면 경고만 한다.
  if [ -n "$(git diff --name-only "$base" "$lsha" -- Cargo.lock 'crates/*/web/package-lock.json' 2>/dev/null)" ]; then
    . scripts/lib.sh
    PY=$(find_python)
    if [ -z "$PY" ]; then echo "- 경고: Python 3.11 이상이 없어 공급망 발행일 검사(scripts/supply.py)를 건너뛴다"
    else
      "$PY" scripts/supply.py --since "$base" --head "$lsha"
      case $? in
        0) ;;
        3) echo "- 경고: 발행일을 확인하지 못했다(네트워크). 네트워크가 되면 scripts/supply.py --since $base 를 돌린다" ;;
        *) fail=1 ;;
      esac
    fi
    # 보안 공지(RustSec): GitHub CI 대신 여기서 본다(2026-11-24 사용자 "로컬에서 다해결"). 네트워크가 없으면 경고만.
    if command -v cargo-deny >/dev/null 2>&1; then
      if ! aout=$(cargo deny check advisories 2>&1); then
        if printf '%s' "$aout" | grep -qiE 'fetch|network|resolve host|timed out'; then
          echo "- 경고: 보안 공지를 받지 못했다(네트워크). 네트워크가 되면 scripts/nightly.sh audit 를 돌린다"
        else printf '%s\n' "$aout" | grep -E '^(error|warning)' | head -20; echo "✗ 보안 공지 — 고치기: 판을 올리거나 결정 문서에 수용 사유를 적고 deny.toml · .cargo/audit.toml 에 같은 사유로 더한다"; fail=1; fi
      else echo "✓ 보안 공지 (cargo deny check advisories)"; fi
    else echo "- 경고: cargo-deny 가 없어 보안 공지 검사를 건너뛴다"; fi
  fi
done
if [ "$fail" -ne 0 ]; then
  echo
  echo "pre-push 관문 실패 — push를 막았다. 위 ✗ 안내대로 고치고 다시 push한다."
  echo "흔들리는 시험 때문이면 scripts/verify.sh --affected --base origin/main 을 다시 돌려 확인한다."
  exit 1
fi
exit 0
