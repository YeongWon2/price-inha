#![cfg(test)]
//! 18차(결정 17 · additions.md C30 · T38): 히스토리 화면의 읽기 조회.
//!
//! - 매매 목록: 최근 것부터 쪽 단위(`before` · `max` 상한 100) · 상태 거르기 · 줄의 칸.
//! - 매매 하나의 흐름: 상태 바뀜(시각 순서) · 계획 · 근거 자료 이름 · 없는 번호 거부.
//! - 승인 요청 기록: 쪽 단위 · 상태 거르기 · 줄의 칸.
//! - 템플릿 판 이력: 판 번호 순서 · 사용자 변경 판의 개선안 번호.
//! - 표 · 쓰기 길 · 판 번호는 그대로다(판 10).
//!
//! 템플릿 판 이력은 `template_revisions`와 비슷하지만 개선안 번호가 없어 새 조회로 둔다.

mod common;

use std::collections::HashSet;

use common::{t, temp_store};
use pi_store::{
    AccountKind, Amount, ApprovalId, ApprovalStatus, ApprovalUse, FactValue, HISTORY_PAGE_MAX,
    Judgment, NewApprovalRequest, NewFact, NewTemplate, NewTrade, NewUserProposal, Rationale,
    RoleScore, SCHEMA_VERSION, SourceRef, Store, StoreError, TemplateId, TradeId, TradeSide,
    TradeState,
};
use serde_json::json;

// ───────────── 도우미 ─────────────

fn new_trade(store: &Store, symbol: &str, at: i64) -> TradeId {
    store
        .create_trade(NewTrade {
            symbol: symbol.to_string(),
            account: AccountKind::Paper,
            at: t(at),
        })
        .unwrap()
        .id
}

fn judgment(decided_at: i64) -> Judgment {
    Judgment {
        decided_at: t(decided_at),
        rationale: Rationale {
            hypothesis: Some("눌림 뒤 되돌림".to_string()),
            trigger: Some("거래량 급증".to_string()),
            entry: Some(Amount(71_500)),
            stop: Some(Amount(69_000)),
            target: Some(Amount(78_000)),
            expected_value: Some(Amount(1_200)),
        },
        sources: vec![SourceRef {
            name: "일봉 시세".to_string(),
            known_at: t(decided_at - 10),
        }],
        scores: vec![RoleScore {
            role: "시세 담당".to_string(),
            score: 70,
            reason: "추세".to_string(),
        }],
        consensus_score: 70,
    }
}

/// 매매 150건: 번호 = 만든 순서(1부터). 3의 배수는 판단됨, 6의 배수는 승인대기까지 갔다.
fn fill_150_trades(store: &Store) {
    for n in 1..=150_i64 {
        let id = new_trade(store, "005930", n);
        assert_eq!(id, TradeId(n));
    }
    for n in (3..=150_i64).step_by(3) {
        store
            .judge_trade(TradeId(n), judgment(1_000 + n))
            .unwrap();
    }
    for n in (6..=150_i64).step_by(6) {
        store
            .transition_trade(TradeId(n), TradeState::AwaitingApproval, t(2_000 + n))
            .unwrap();
    }
}

fn ids(page: &[pi_store::TradeListItem]) -> Vec<i64> {
    page.iter().map(|line| line.id.0).collect()
}

fn new_approval(store: &Store, label: &str, at: i64) -> ApprovalId {
    store
        .create_approval(NewApprovalRequest {
            fingerprint: format!("sha256:{label}"),
            summary: json!({ "대상": label }),
            created_at: t(at),
            expires_at: t(1_000_000),
        })
        .unwrap()
        .id
}

/// 승인 요청 150건: 번호 = 만든 순서. 3의 배수는 승인, 5의 배수(3의 배수가 아닌 것)는 거절.
fn fill_150_approvals(store: &Store) {
    for n in 1..=150_i64 {
        let id = new_approval(store, &format!("항목{n}"), n);
        assert_eq!(id, ApprovalId(n));
    }
    for n in 1..=150_i64 {
        if n % 3 == 0 {
            store
                .resolve_approval(ApprovalId(n), ApprovalStatus::Approved, t(500 + n))
                .unwrap();
        } else if n % 5 == 0 {
            store
                .resolve_approval(ApprovalId(n), ApprovalStatus::Rejected, t(500 + n))
                .unwrap();
        }
    }
}

fn approval_ids(page: &[pi_store::ApprovalLine]) -> Vec<i64> {
    page.iter().map(|line| line.id.0).collect()
}

fn approved_use(store: &Store, fingerprint: &str) -> ApprovalUse {
    let id = new_approval(store, fingerprint, 0);
    store
        .resolve_approval(id, ApprovalStatus::Approved, t(1))
        .unwrap();
    ApprovalUse {
        id,
        fingerprint: format!("sha256:{fingerprint}"),
    }
}

// ───────────── 매매 목록 ─────────────

// 검증: R6-3, F7-7
#[test]
fn 빈_저장소에서는_빈_목록이고_하나_만들면_그_하나만_나온다() {
    let (_dir, _path, store) = temp_store();
    assert!(store.trade_page(None, 50, None).unwrap().is_empty());
    assert!(
        store
            .trade_page(None, 50, Some(TradeState::Judged))
            .unwrap()
            .is_empty()
    );

    new_trade(&store, "005930", 1);

    let page = store.trade_page(None, 50, None).unwrap();
    assert_eq!(ids(&page), vec![1]);
}

// 검증: R6-3, F7-7
#[test]
fn 매매_150건을_100건씩_넘기면_겹침도_빠짐도_없고_최근_것부터다() {
    let (_dir, _path, store) = temp_store();
    fill_150_trades(&store);

    let first = store.trade_page(None, 100, None).unwrap();
    assert_eq!(first.len(), 100);
    assert_eq!(ids(&first), (51..=150).rev().collect::<Vec<i64>>());

    let last_of_first = first.last().unwrap().id;
    let second = store.trade_page(Some(last_of_first), 100, None).unwrap();
    assert_eq!(second.len(), 50);
    assert_eq!(ids(&second), (1..=50).rev().collect::<Vec<i64>>());

    let all: HashSet<i64> = ids(&first).into_iter().chain(ids(&second)).collect();
    assert_eq!(all.len(), 150);

    let after_last = store
        .trade_page(Some(second.last().unwrap().id), 100, None)
        .unwrap();
    assert!(after_last.is_empty());
}

// 검증: R6-3, F7-7
#[test]
fn 쪽_크기는_상한_100으로_줄고_작게_달라고_하면_그만큼만_온다() {
    let (_dir, _path, store) = temp_store();
    fill_150_trades(&store);
    assert_eq!(HISTORY_PAGE_MAX, 100);

    assert_eq!(store.trade_page(None, 1_000, None).unwrap().len(), 100);
    assert_eq!(store.trade_page(None, usize::MAX, None).unwrap().len(), 100);
    assert_eq!(ids(&store.trade_page(None, 3, None).unwrap()), vec![150, 149, 148]);
    assert!(store.trade_page(None, 0, None).unwrap().is_empty());
}

// 검증: R6-3, F7-7
#[test]
fn before가_가장_작은_번호_이하이면_빈_목록이고_가운데_번호이면_그_아래부터다() {
    let (_dir, _path, store) = temp_store();
    fill_150_trades(&store);

    assert!(store.trade_page(Some(TradeId(1)), 10, None).unwrap().is_empty());
    let middle = store.trade_page(Some(TradeId(10)), 4, None).unwrap();
    assert_eq!(ids(&middle), vec![9, 8, 7, 6]);
    let above = store.trade_page(Some(TradeId(10_000)), 2, None).unwrap();
    assert_eq!(ids(&above), vec![150, 149]);
}

// 검증: R6-3, F7-7
#[test]
fn 상태로_거르면_그_상태만_쪽_단위로_나오고_없는_상태는_빈_목록이다() {
    let (_dir, _path, store) = temp_store();
    fill_150_trades(&store);

    // 판단됨: 3의 배수 중 6의 배수가 아닌 것(25건).
    let judged = store
        .trade_page(None, 100, Some(TradeState::Judged))
        .unwrap();
    assert_eq!(judged.len(), 25);
    assert!(judged.iter().all(|line| line.state == TradeState::Judged));
    let expected: Vec<i64> = (1..=150).rev().filter(|n| n % 3 == 0 && n % 6 != 0).collect();
    assert_eq!(ids(&judged), expected);

    // 승인대기: 6의 배수(25건).
    let waiting = store
        .trade_page(None, 100, Some(TradeState::AwaitingApproval))
        .unwrap();
    assert_eq!(waiting.len(), 25);
    assert!(
        waiting
            .iter()
            .all(|line| line.state == TradeState::AwaitingApproval)
    );

    // 논의중: 3의 배수가 아닌 100건. 한 쪽에 상한만큼, 다음 쪽은 거르기를 지킨 채 이어진다.
    let discussing_first = store
        .trade_page(None, 60, Some(TradeState::Discussing))
        .unwrap();
    assert_eq!(discussing_first.len(), 60);
    let discussing_rest = store
        .trade_page(
            Some(discussing_first.last().unwrap().id),
            100,
            Some(TradeState::Discussing),
        )
        .unwrap();
    assert_eq!(discussing_rest.len(), 40);
    assert!(
        discussing_first
            .iter()
            .chain(discussing_rest.iter())
            .all(|line| line.state == TradeState::Discussing && line.id.0 % 3 != 0)
    );

    // 없는 상태.
    assert!(
        store
            .trade_page(None, 100, Some(TradeState::Sold))
            .unwrap()
            .is_empty()
    );
}

// 검증: R6-3, F7-7
#[test]
fn 줄에는_번호_종목_계좌_상태_만든_시각_바뀐_시각_판단_시각이_담긴다() {
    let (_dir, _path, store) = temp_store();
    fill_150_trades(&store);

    let page = store.trade_page(None, 150, None).unwrap();
    assert_eq!(page.len(), 100);
    let by_id = |n: i64| page.iter().find(|line| line.id.0 == n).cloned();

    // 논의중(140): 판단 시각 없음, 바뀐 시각은 만든 시각.
    let discussing = by_id(140).unwrap();
    assert_eq!(discussing.symbol, "005930");
    assert_eq!(discussing.account, AccountKind::Paper);
    assert_eq!(discussing.state, TradeState::Discussing);
    assert_eq!(discussing.created_at, t(140));
    assert_eq!(discussing.updated_at, t(140));
    assert_eq!(discussing.decided_at, None);

    // 판단됨(147): 판단 시각이 있다.
    let judged = by_id(147).unwrap();
    assert_eq!(judged.state, TradeState::Judged);
    assert_eq!(judged.created_at, t(147));
    assert_eq!(judged.decided_at, Some(t(1_147)));

    // 승인대기(144): 바뀐 시각은 전이의 시각이고 판단 시각은 그대로다.
    let waiting = by_id(144).unwrap();
    assert_eq!(waiting.state, TradeState::AwaitingApproval);
    assert_eq!(waiting.created_at, t(144));
    assert_eq!(waiting.updated_at, t(2_144));
    assert_eq!(waiting.decided_at, Some(t(1_144)));
}

// ───────────── 매매 하나의 흐름 ─────────────

fn fact(label: &str, known_at: i64) -> NewFact {
    NewFact {
        kind: "disclosure".to_string(),
        subject: "005930".to_string(),
        label: label.to_string(),
        period: None,
        value: FactValue::Text("보고서".to_string()),
        unit: None,
        reference: None,
        source_name: "시험 공시".to_string(),
        source_url: "http://127.0.0.1/none".to_string(),
        published_on: None,
        known_at: t(known_at),
    }
}

// 검증: R6-3, F7-7
#[test]
fn 갓_만든_매매의_흐름은_만든_줄_하나이고_계획과_자료는_비어_있다() {
    let (_dir, _path, store) = temp_store();
    let id = new_trade(&store, "005930", 5);

    let flow = store.trade_flow(id).unwrap();

    assert_eq!(flow.id, id);
    assert_eq!(flow.states.len(), 1);
    assert_eq!(flow.states[0].from, None);
    assert_eq!(flow.states[0].to, TradeState::Discussing);
    assert_eq!(flow.states[0].at, t(5));
    assert_eq!(flow.side, None);
    assert_eq!(flow.quantity, None);
    assert!(flow.fact_labels.is_empty());
}

// 검증: R6-3, F7-7
#[test]
fn 매매_흐름은_상태_바뀜을_시각_순서로_계획과_자료_이름과_함께_돌려준다() {
    let (_dir, _path, store) = temp_store();
    let id = new_trade(&store, "005930", 5);
    let other = new_trade(&store, "000660", 6);
    let facts = store
        .save_facts(&[fact("분기보고서", 40), fact("지분공시", 50)])
        .unwrap();
    store
        .judge_trade_with_side(id, judgment(100), TradeSide::Sell)
        .unwrap();
    store.set_trade_quantity(id, 7).unwrap();
    store
        .attach_trade_facts(id, &[facts[1].id, facts[0].id])
        .unwrap();
    store
        .transition_trade(id, TradeState::AwaitingApproval, t(200))
        .unwrap();
    // 다른 매매의 바뀜은 섞이지 않는다.
    store.judge_trade(other, judgment(150)).unwrap();

    let flow = store.trade_flow(id).unwrap();

    let steps: Vec<(Option<TradeState>, TradeState, i64)> = flow
        .states
        .iter()
        .map(|change| (change.from, change.to, change.at.0 - t(0).0))
        .collect();
    assert_eq!(
        steps,
        vec![
            (None, TradeState::Discussing, 5),
            (Some(TradeState::Discussing), TradeState::Judged, 100),
            (Some(TradeState::Judged), TradeState::AwaitingApproval, 200),
        ]
    );
    assert!(flow.states.iter().all(|change| change.trade == id));
    assert!(flow.states.windows(2).all(|pair| pair[0].at <= pair[1].at));
    assert_eq!(flow.side, Some(TradeSide::Sell));
    assert_eq!(flow.quantity, Some(7));
    assert_eq!(
        flow.fact_labels,
        vec!["지분공시".to_string(), "분기보고서".to_string()]
    );
}

// 검증: R6-3, F7-7
