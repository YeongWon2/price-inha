// 검증: R4-3, F7-7
#[test]
fn 승인_기록_150건을_100건씩_넘기면_겹침도_빠짐도_없고_최근_것부터다() {
    let (_dir, _path, store) = temp_store();
    fill_150_approvals(&store);

    let first = store.approval_page(None, 100, None).unwrap();
    assert_eq!(first.len(), 100);
    assert_eq!(approval_ids(&first), (51..=150).rev().collect::<Vec<i64>>());

    let second = store
        .approval_page(Some(first.last().unwrap().id), 100, None)
        .unwrap();
    assert_eq!(approval_ids(&second), (1..=50).rev().collect::<Vec<i64>>());

    assert_eq!(store.approval_page(None, 1_000, None).unwrap().len(), 100);
    assert!(store.approval_page(None, 0, None).unwrap().is_empty());
    assert_eq!(
        approval_ids(&store.approval_page(Some(ApprovalId(10)), 3, None).unwrap()),
        vec![9, 8, 7]
    );
}

// 검증: R4-3, F7-7
#[test]
fn 승인_기록을_상태로_거르면_그_상태만_나온다() {
    let (_dir, _path, store) = temp_store();
    fill_150_approvals(&store);

    let approved = store
        .approval_page(None, 100, Some(ApprovalStatus::Approved))
        .unwrap();
    assert_eq!(
        approval_ids(&approved),
        (1..=150).rev().filter(|n| n % 3 == 0).collect::<Vec<i64>>()
    );
    assert!(
        approved
            .iter()
            .all(|line| line.status == ApprovalStatus::Approved)
    );

    let rejected = store
        .approval_page(None, 100, Some(ApprovalStatus::Rejected))
        .unwrap();
    assert_eq!(
        approval_ids(&rejected),
        (1..=150)
            .rev()
            .filter(|n| n % 3 != 0 && n % 5 == 0)
            .collect::<Vec<i64>>()
    );

    let pending_first = store
        .approval_page(None, 100, Some(ApprovalStatus::Pending))
        .unwrap();
    assert_eq!(pending_first.len(), 80 - 0);
    assert!(
        pending_first
            .iter()
            .all(|line| line.status == ApprovalStatus::Pending)
    );

    assert!(
        store
            .approval_page(None, 100, Some(ApprovalStatus::Expired))
            .unwrap()
            .is_empty()
    );
}

// 검증: R4-3, F7-7
#[test]
fn 승인_기록_줄에는_번호_요약_상태_만든_닫힌_쓴_시각이_담긴다() {
    let (_dir, _path, store) = temp_store();
    let pending = new_approval(&store, "기다림", 10);
    let answered = new_approval(&store, "승인됨", 11);
    store
        .resolve_approval(answered, ApprovalStatus::Approved, t(20))
        .unwrap();
    let used = new_approval(&store, "쓴것", 12);
    store
        .resolve_approval(used, ApprovalStatus::Approved, t(21))
        .unwrap();
    store
        .consume_approval(
            ApprovalUse {
                id: used,
                fingerprint: "sha256:쓴것".to_string(),
            },
            t(30),
        )
        .unwrap();

    let page = store.approval_page(None, 10, None).unwrap();
    assert_eq!(approval_ids(&page), vec![used.0, answered.0, pending.0]);

    let line = |id: ApprovalId| page.iter().find(|line| line.id == id).unwrap().clone();

    let waiting = line(pending);
    assert_eq!(waiting.summary, json!({ "대상": "기다림" }));
    assert_eq!(waiting.status, ApprovalStatus::Pending);
    assert_eq!(waiting.created_at, t(10));
    assert_eq!(waiting.resolved_at, None);
    assert_eq!(waiting.consumed_at, None);

    let closed = line(answered);
    assert_eq!(closed.status, ApprovalStatus::Approved);
    assert_eq!(closed.created_at, t(11));
    assert_eq!(closed.resolved_at, Some(t(20)));
    assert_eq!(closed.consumed_at, None);

    let spent = line(used);
    assert_eq!(spent.resolved_at, Some(t(21)));
    assert_eq!(spent.consumed_at, Some(t(30)));
}

// ───────────── 템플릿 판 이력 ─────────────

// 검증: R10-2, F7-7
#[test]
fn 템플릿_판_이력은_판_번호_순서이고_사용자_변경_판에만_개선안_번호가_붙는다() {
    let (_dir, _path, store) = temp_store();
    let template = store
        .create_template(NewTemplate {
            value: json!({ "R%": "1.0" }),
            at: t(0),
        })
        .unwrap();
    store
        .revise_template(template.id, &json!({ "R%": "1.2" }), t(10))
        .unwrap();
    let proposal = store
        .create_user_proposal(NewUserProposal {
            template: template.id,
            content: json!({ "R%": "1.5" }),
            at: t(30),
        })
        .unwrap();
    let use_ = approved_use(&store, "user-proposal");
    store.approve_proposal(proposal.id, use_, t(31)).unwrap();
    store
        .apply_cooled_user_proposal(proposal.id, &json!({ "R%": "1.5" }), t(40))
        .unwrap();
    store
        .revise_template(template.id, &json!({ "R%": "1.6" }), t(50))
        .unwrap();

    let history = store.template_history(template.id).unwrap();

    let rows: Vec<(u32, serde_json::Value, i64, Option<i64>)> = history
        .iter()
        .map(|line| {
            (
                line.revision,
                line.value.clone(),
                line.at.0 - t(0).0,
                line.proposal.map(|id| id.0),
            )
        })
        .collect();
    assert_eq!(
        rows,
        vec![
            (1, json!({ "R%": "1.0" }), 0, None),
            (2, json!({ "R%": "1.2" }), 10, None),
            (3, json!({ "R%": "1.5" }), 40, Some(proposal.id.0)),
            (4, json!({ "R%": "1.6" }), 50, None),
        ]
    );
}

// 검증: R10-2, F7-7
#[test]
fn 갓_만든_템플릿의_판_이력은_판_1_하나이고_없는_템플릿은_찾지_못함이다() {
    let (_dir, _path, store) = temp_store();
    let template = store
        .create_template(NewTemplate {
            value: json!({ "R%": "1.0" }),
            at: t(3),
        })
        .unwrap();

    let history = store.template_history(template.id).unwrap();
    assert_eq!(history.len(), 1);
    assert_eq!(history[0].revision, 1);
    assert_eq!(history[0].at, t(3));
    assert_eq!(history[0].proposal, None);

    let missing = store.template_history(TemplateId(999));
    assert!(matches!(
        missing,
        Err(StoreError::TemplateNotFound(TemplateId(999)))
    ));
}

// ───────────── 읽기만 한다 ─────────────

// 검증: R6-3, R4-3, R10-2
#[test]
fn 조회는_저장소를_바꾸지_않고_표와_판_번호도_그대로다() {
    let (_dir, path, store) = temp_store();
    fill_150_trades(&store);
    new_approval(&store, "하나", 1);
    let template = store
        .create_template(NewTemplate {
            value: json!({ "R%": "1.0" }),
            at: t(0),
        })
        .unwrap();
    let before = store.info().unwrap();

    let first = store.trade_page(None, 100, None).unwrap();
    store.trade_flow(TradeId(6)).unwrap();
    store.approval_page(None, 100, None).unwrap();
    store.template_history(template.id).unwrap();
    let again = store.trade_page(None, 100, None).unwrap();

    assert_eq!(first, again);
    assert_eq!(store.info().unwrap(), before);
    assert_eq!(before.schema_version, 10);
    assert_eq!(SCHEMA_VERSION, 10);

    // 다시 열어도 같은 목록이다.
    drop(store);
    let reopened = Store::open(&path).unwrap();
    assert_eq!(reopened.trade_page(None, 100, None).unwrap(), first);
}
